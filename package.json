    "tsc-alias": "^1.8.10",
    "ts-jest": "29.2.5",
    "ts-node": "10.9.1",
    "typescript": "5.8.3",
    "vite": "7.3.1"
  },
  "prisma": {
    "schema": "configs/db/schema.prisma",
    "seed": "ts-node configs/db/seed.ts"
  },
