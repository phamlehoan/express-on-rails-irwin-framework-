{
  "name": "irwin-framework",
  "version": "1.0.0",
  "main": "index.js",
  "author": "Peter Pham",
  "license": "MIT",
  "scripts": {
    "build": "yarn build-client && tsc && tsc-alias && node dist/index.js",
    "serverless": "yarn build-client && tsc && tsc-alias && serverless offline --noPrependStageInUrl",
    "start": "yarn build-client && node dist/index.js",
    "dev": "nodemon -e js,ts,pug,vue,json index.ts",
    "db:deploy": "npx prisma migrate deploy",
    "db:generate": "npx prisma migrate dev --create-only",
    "db:migrate": "npx prisma migrate dev",
    "db:seed": "ts-node db/seed.ts",
    "build-client": "vite build",
    "git": "sh .vscode/git.sh",
    "routes": "ts-node lib/commands/routes.ts",
    "console": "ts-node -r tsconfig-paths/register lib/commands/console.ts",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@popperjs/core": "2.11.8",
    "@prisma/client": "5.22.0",
    "@supabase/supabase-js": "2.49.4",
    "axios": "1.7.3",
    "body-parser": "1.20.2",
    "bootstrap": "5.3.2",
    "browserify": "17.0.0",
    "child_process": "1.0.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cloudinary": "2.6.0",
    "cookie-parser": "1.4.6",
    "cors": "2.8.5",
    "dayjs": "1.11.12",
    "decimal.js": "10.4.3",
    "dotenv": "16.5.0",
    "express": "4.18.2",
    "express-flash": "0.0.2",
    "express-session": "1.17.1",
    "font-awesome": "4.7.0",
    "google-auth-library": "9.15.1",
    "googleapis": "140.0.1",
    "i18next": "25.8.14",
    "i18next-fs-backend": "2.6.1",
    "jquery": "3.7.1",
    "jsonwebtoken": "9.0.2",
    "lodash": "4.17.5",
    "md5": "2.3.0",
    "method-override": "3.0.0",
    "multer": "1.4.5-lts.2",
    "node-cache": "5.1.2",
    "node-cron": "4.2.1",
    "node-sass": "9.0.0",
