  "devDependencies": {
    "@faker-js/faker": "8.4.1",
    "cross-env": "^7.0.3",
    "@types/cookie-parser": "1.4.6",
    "@types/cors": "2.8.17",
    "@types/express": "4.17.13",
    "@types/express-flash": "0.0.5",
    "@types/express-session": "1.17.1",
    "@types/jest": "30.0.0",
