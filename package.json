    "nodemailer": "^6.10.1",
    "pino": "^10.3.1",
    "pluralize": "^8.0.0",
    "prisma": "^7.7.0",
    "pug": "^3.0.4",
    "punycode": "^2.3.1",
    "reflect-metadata": "^0.2.2",
    "serverless-http": "^3.2.0",
