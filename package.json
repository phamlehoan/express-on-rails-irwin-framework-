    "prisma": "5.22.0",
    "pug": "3.0.2",
    "reflect-metadata": "0.2.2",
    "serverless": "4.33.0",
    "serverless-http": "3.2.0",
    "sharp": "0.34.1",
    "socket.io": "4.8.3",
    "sqlite3": "5.1.7",
