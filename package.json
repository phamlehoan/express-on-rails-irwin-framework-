{
  "name": "irwin-framework",
  "version": "1.0.0",
  "main": "index.js",
  "author": "Peter Pham",
  "license": "MIT",
  "scripts": {
    "clean:dist": "node scripts/cleanDist.mjs",
    "build": "prisma generate && vite build && pnpm clean:dist && tsc && tsc-alias",
    "deploy": "prisma generate && pnpm db:deploy:turso && vite build && pnpm clean:dist && tsc && tsc-alias",
    "netlify-build": "prisma generate && node scripts/netlifyWriteRuntimeSecrets.mjs && vite build && pnpm clean:dist && tsc && tsc-alias",
    "netlify-build:ci": "node scripts/runWithDotenv.mjs -- pnpm netlify-build",
    "netlify:deploy:prod": "pnpm exec netlify deploy --prod --dir=dist --functions=netlify/functions",
    "vercel-build": "prisma generate && pnpm db:deploy:turso && vite build && pnpm clean:dist && tsc && tsc-alias",
    "start": "node dist/index.js",
    "serverless": "vite build && pnpm clean:dist && tsc && tsc-alias && serverless offline --noPrependStageInUrl",
    "dev": "nodemon -e js,ts,pug,vue,json --exec tsx index.ts",
    "db:generate": "pnpm prisma generate",
    "db:add": "prisma migrate dev --create-only",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:deploy:turso": "tsx configs/db/scripts/migrateTurso.ts",
    "db:deploy:turso:dry": "tsx configs/db/scripts/migrateTurso.ts --dry-run",
    "db:deploy:turso:baseline": "tsx configs/db/scripts/migrateTurso.ts --baseline",
    "db:rollback": "prisma migrate resolve --rolled-back",
    "db:seed": "tsx configs/db/seed.ts",
    "build-client": "vite build",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.0",
    "@libsql/client": "0.15.15",
    "@netlify/functions": "^5.2.0",
    "@popperjs/core": "^2.11.8",
    "@prisma/adapter-better-sqlite3": "^7.7.0",
    "@prisma/adapter-libsql": "7.7.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.7.0",
    "@supabase/supabase-js": "^2.103.0",
    "axios": "^1.15.0",
    "bcrypt": "^5.1.1",
