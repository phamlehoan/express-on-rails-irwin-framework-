extends ../layouts/auth/layout

block content
  .row
    .col-lg-6.d-none.d-lg-block
      img.auth-hero-img.img-fluid(src='/images/img/auth-hero.svg' alt='')
    .col-lg-6
      .p-5
        .text-center
          h1.h4.text-gray-900.mb-2= t('users.register_title')
          p.small.text-muted.mb-4= t('users.register_subtitle')
        form.user(action=withLocale('/users') method='POST')
          .form-group.row
            .col-sm-6.mb-3.mb-sm-0
              input.form-control.form-control-user(
                type='text'
                name='firstName'
                required
                autocomplete='given-name'
                placeholder=t('admin.first_name')
              )
            .col-sm-6
              input.form-control.form-control-user(
                type='text'
                name='lastName'
                required
                autocomplete='family-name'
                placeholder=t('admin.last_name')
              )
          .form-group
            input.form-control.form-control-user(
              type='text'
              name='middleName'
              autocomplete='additional-name'
              placeholder=t('users.middle_name_optional')
            )
          .form-group
            input.form-control.form-control-user(
              type='email'
              name='email'
              required
              autocomplete='email'
              placeholder=t('auth.enter_email')
            )
          .small.text-muted.mb-3= t('users.register_email_hint')
          button.btn.btn-primary.btn-user.btn-block(type='submit')
            = t('users.register_submit')
          hr
        .text-center
          a.small(href=withLocale('/auth'))= t('users.already_have_account')
