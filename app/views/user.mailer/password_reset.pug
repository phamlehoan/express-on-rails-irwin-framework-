doctype html
html
  head
    meta(charset="utf-8")
    style.
      .container { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; max-width: 600px; margin: 0 auto; padding: 20px; color: #333; line-height: 1.6; }
      .header { background-color: #e74a3b; padding: 30px; text-align: center; border-radius: 8px 8px 0 0; }
      .header h1 { color: #ffffff; margin: 0; font-size: 24px; }
      .content { background-color: #ffffff; padding: 30px; border: 1px solid #e3e6f0; border-top: none; border-radius: 0 0 8px 8px; }
      .footer { text-align: center; margin-top: 20px; font-size: 12px; color: #858796; }
      .btn { display: inline-block; padding: 12px 24px; background-color: #e74a3b; color: #ffffff !important; text-decoration: none; border-radius: 5px; font-weight: bold; margin-top: 20px; }
      .warning { font-size: 13px; color: #858796; font-style: italic; margin-top: 20px; }
  body
    .container
      .header
        h1 #{t('mailer.password_reset.title')}
      .content
        p #{t('mailer.password_reset.greeting')}
        p #{t('mailer.password_reset.request_msg')}
          strong #{to}
        p #{t('mailer.password_reset.instruction')}

        div(style="text-align: center")
          a.btn(href=resetLink) #{t('mailer.password_reset.button')}

        p.warning #{t('mailer.password_reset.warning')}

        p(style="margin-top: 30px") #{t('mailer.common.regards')}
        p
          strong #{t('mailer.common.team', { appName })}
      .footer
        p #{t('footer.copyright', { year: new Date().getFullYear(), appName })}