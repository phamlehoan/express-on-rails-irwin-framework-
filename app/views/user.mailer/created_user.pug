doctype html
html
  head
    meta(charset="utf-8")
    style.
      .container { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; max-width: 600px; margin: 0 auto; padding: 20px; color: #333; line-height: 1.6; }
      .header { background-color: #4e73df; padding: 30px; text-align: center; border-radius: 8px 8px 0 0; }
      .header h1 { color: #ffffff; margin: 0; font-size: 24px; }
      .content { background-color: #ffffff; padding: 30px; border: 1px solid #e3e6f0; border-top: none; border-radius: 0 0 8px 8px; }
      .footer { text-align: center; margin-top: 20px; font-size: 12px; color: #858796; }
      .btn { display: inline-block; padding: 12px 24px; background-color: #4e73df; color: #ffffff !important; text-decoration: none; border-radius: 5px; font-weight: bold; margin-top: 20px; }
      .user-info { background-color: #f8f9fc; padding: 15px; border-radius: 5px; margin: 20px 0; border-left: 4px solid #4e73df; }
  body
    .container
      .header
        h1 #{t('app_name')}
      .content
        h2 #{t('mailer.created_user.greeting', { name: fullName })}
        p #{t('mailer.created_user.success_msg')}

        .user-info
          p(style="margin:0")
            strong #{t('mailer.created_user.login_email')}
            | #{to}

        p #{t('mailer.created_user.explore_msg', { appName })}

        div(style="text-align: center")
          a.btn(href="#") #{t('mailer.created_user.access_account')}

        p(style="margin-top: 30px") #{t('mailer.common.regards')}
        p
          strong #{t('mailer.common.team', { appName })}
      .footer
        p #{t('mailer.common.auto_email_footer')}
        p #{t('footer.copyright', { year: new Date().getFullYear(), appName })}