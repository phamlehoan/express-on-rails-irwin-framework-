extends ../layouts/main/layout

block content
  header.masthead
    .container
      .masthead-subheading= t('landing.masthead_subheading')
      .masthead-heading.text-uppercase= t('landing.masthead_heading')
      a.btn.btn-primary.btn-xl.text-uppercase(href='#services')= t('landing.masthead_cta')
    script(type="text/javascript" src="/javascripts/mainLayout/navBar.js")
  section#services.page-section
    .container
      .text-center
        h2.section-heading.text-uppercase= t('landing.services_heading')
        h3.section-subheading.text-muted= t('landing.services_intro')
      .row.text-center
        .col-md-4
          span.fa-stack.fa-4x
            i.fa.fa-circle.fa-stack-2x.text-primary
            i.fa.fa-terminal.fa-stack-1x.fa-inverse
          h4.my-3= t('landing.service_dev_title')
          p.text-muted= t('landing.service_dev_body')
        .col-md-4
          span.fa-stack.fa-4x
            i.fa.fa-circle.fa-stack-2x.text-primary
            i.fa.fa-laptop.fa-stack-1x.fa-inverse
          h4.my-3= t('landing.service_admin_title')
          p.text-muted= t('landing.service_admin_body')
        .col-md-4
          span.fa-stack.fa-4x
            i.fa.fa-circle.fa-stack-2x.text-primary
            i.fa.fa-lock.fa-stack-1x.fa-inverse
          h4.my-3= t('landing.service_secure_title')
          p.text-muted= t('landing.service_secure_body')
  section#highlights.page-section.bg-light
    .container
      .text-center
        h2.section-heading.text-uppercase= t('landing.highlights_heading')
        h3.section-subheading.text-muted= t('landing.highlights_intro')
      .row.text-center
        .col-md-4.mb-4.mb-md-0
          span.fa-stack.fa-4x
            i.fa.fa-circle.fa-stack-2x.text-primary
            i.fa.fa-folder-open.fa-stack-1x.fa-inverse
          h4.my-3= t('landing.highlight1_title')
          p.text-muted= t('landing.highlight1_body')
        .col-md-4.mb-4.mb-md-0
          span.fa-stack.fa-4x
            i.fa.fa-circle.fa-stack-2x.text-primary
            i.fa.fa-plug.fa-stack-1x.fa-inverse
          h4.my-3= t('landing.highlight2_title')
          p.text-muted= t('landing.highlight2_body')
        .col-md-4
          span.fa-stack.fa-4x
            i.fa.fa-circle.fa-stack-2x.text-primary
            i.fa.fa-bolt.fa-stack-1x.fa-inverse
          h4.my-3= t('landing.highlight3_title')
          p.text-muted= t('landing.highlight3_body')
  section#about.page-section
    .container
      .text-center
        h2.section-heading.text-uppercase= t('landing.about_heading')
        h3.section-subheading.text-muted= t('landing.about_intro')
      ul.timeline
        li
          .timeline-image
            img.rounded-circle.img-fluid(src='/images/img/about/1.jpg' alt='')
          .timeline-panel
            .timeline-heading
              h4= t('landing.about_milestone1_date')
              h4.subheading= t('landing.about_milestone1_title')
            .timeline-body
              p.text-muted= t('landing.about_milestone1_body')
        li.timeline-inverted
          .timeline-image
            img.rounded-circle.img-fluid(src='/images/img/about/2.jpg' alt='')
          .timeline-panel
            .timeline-heading
              h4= t('landing.about_milestone2_date')
              h4.subheading= t('landing.about_milestone2_title')
            .timeline-body
              p.text-muted= t('landing.about_milestone2_body')
        li
          .timeline-image
            img.rounded-circle.img-fluid(src='/images/img/about/1.jpg' alt='')
          .timeline-panel
            .timeline-heading
              h4= t('landing.about_milestone3_date')
              h4.subheading= t('landing.about_milestone3_title')
            .timeline-body
              p.text-muted= t('landing.about_milestone3_body')
        li.timeline-inverted
          .timeline-image.timeline-image--cta
            h4
              | #{t('landing.about_cta_line1')}
              br
              | #{t('landing.about_cta_line2')}
              br
              | #{t('landing.about_cta_line3')}
              br
              | #{t('landing.about_cta_line4')}
  section#team.page-section.bg-light
    .container
      .text-center
        h2.section-heading.text-uppercase= t('landing.team_heading')
        h3.section-subheading.text-muted= t('landing.team_intro')
      .row
        .col-lg-4.mx-auto
          .team-member
            img.mx-auto.rounded-circle(src='/images/img/team/1.png' alt='Hoan Pham')
            h4 Hoan Pham
            p.text-muted Developer
            a.btn.btn-dark.btn-social.mx-2(href='#!', aria-label='Hoan Pham Twitter Profile')
              i.fa.fa-twitter
            a.btn.btn-dark.btn-social.mx-2(href='#!', aria-label='Hoan Pham Facebook Profile')
              i.fa.fa-facebook-f
            a.btn.btn-dark.btn-social.mx-2(href='#!', aria-label='Hoan Pham LinkedIn Profile')
              i.fa.fa-google
      .row
        .col-lg-8.mx-auto.text-center
          p.large.text-muted= t('landing.team_close')
