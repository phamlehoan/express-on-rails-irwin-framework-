extends ../../layouts/admin/layout

block content
  .container-fluid#adminProfileApp
    nav(aria-label="breadcrumb").breadcrumb-sticky
      ol.breadcrumb.mb-0
        li.breadcrumb-item
          a(href="/admin")= t('header.admin')
        li.breadcrumb-item.active(aria-current="page")= t('profile.my_profile')

    .card.mb-4.content-card
      .card-header.d-flex.justify-content-between.align-items-center
        h6.mb-0.text-uppercase.text-primary.fw-bold Personal Information
        button.btn.btn-sm(:class="isEdit ? 'btn-outline-secondary' : 'btn-warning'" @click="toggleEdit")
          | {{ isEdit ? 'Cancel' : 'Edit' }}
      .card-body
        template(v-if="!isEdit")
          .row
            .col-md-4.mb-3
              label.text-muted.small First Name
              p.mb-0.fw-semibold {{ user.firstName }}
            .col-md-4.mb-3
              label.text-muted.small Last Name
              p.mb-0.fw-semibold {{ user.lastName }}
            .col-md-4.mb-3
              label.text-muted.small Email
              p.mb-0.fw-semibold {{ user.email }}
            .col-md-4.mb-3(v-if="user.phoneNumber")
              label.text-muted.small Phone
              p.mb-0.fw-semibold {{ user.phoneNumber }}
            .col-md-4.mb-3(v-if="user.gender")
              label.text-muted.small Gender
              p.mb-0.fw-semibold {{ user.gender }}
            .col-12.mb-3
              label.text-muted.small Roles
              .d-flex.flex-wrap.gap-2
                span.badge.bg-primary(v-for="ur in user.roles" :key="ur.roleId") {{ ur.role.name }}
            .col-12.mb-3(v-if="user.address")
              label.text-muted.small Address
              p.mb-0 {{ user.address }}
        form(v-else @submit.prevent="saveProfile")
          .row
            .col-md-6.mb-3
              label.form-label First Name
              input.form-control(v-model="form.firstName" required)
            .col-md-6.mb-3
              label.form-label Last Name
              input.form-control(v-model="form.lastName" required)
            .col-md-6.mb-3
              label.form-label Email
              input.form-control(type="text" :value="user.email" disabled)
              small.text-muted Email cannot be changed
            .col-md-6.mb-3
              label.form-label Phone
              input.form-control(v-model="form.phoneNumber")
            .col-md-6.mb-3
              label.form-label Gender
              select.form-select(v-model="form.gender")
                option(value="") -- Select --
                option(value="male") Male
                option(value="female") Female
                option(value="other") Other
            .col-12.mb-3
              label.form-label Address
              textarea.form-control(v-model="form.address" rows="2")
            .col-12.mb-3
              label.form-label Roles (Admin only)
              .form-check(v-for="r in roles" :key="r.id")
                input.form-check-input(type="checkbox" :value="r.id" v-model="form.roleIds" :id="`adminRole-${r.id}`")
                label.form-check-label(:for="`adminRole-${r.id}`") {{ r.name }}
          button.btn.btn-primary(type="submit") Save

  script.
    (function() {
      const data = !{JSON.stringify({ currentUser, roles })};
      const user = data.currentUser;

      const mountEl = document.getElementById('adminProfileApp');
      let template = '';
      if (mountEl) {
        const clone = mountEl.cloneNode(true);
        clone.querySelectorAll('script').forEach(s => s.remove());
        template = clone.innerHTML;
      }

      const app = Vue.createApp({
        template: template || '<div>Loading...</div>',
        data() {
          return {
            user,
            roles: data.roles,
            isEdit: false,
            form: {
              firstName: user.firstName,
              lastName: user.lastName,
              phoneNumber: user.phoneNumber || '',
              address: user.address || '',
              gender: user.gender || '',
              roleIds: (user.roles || []).map(ur => ur.roleId)
            }
          };
        },
        methods: {
          toggleEdit() {
            this.isEdit = !this.isEdit;
            if (!this.isEdit) this.resetForm();
          },
          resetForm() {
            this.form = {
              firstName: this.user.firstName,
              lastName: this.user.lastName,
              phoneNumber: this.user.phoneNumber || '',
              address: this.user.address || '',
              gender: this.user.gender || '',
              roleIds: (this.user.roles || []).map(ur => ur.roleId)
            };
          },
          saveProfile() {
            const form = document.createElement('form');
            form.method = 'POST';
            form.action = '/admin/me?_method=PUT';
            ['firstName','lastName','phoneNumber','address','gender'].forEach(k => {
              const i = document.createElement('input');
              i.name = k;
              i.value = this.form[k] || '';
              form.appendChild(i);
            });
            this.form.roleIds.forEach(id => {
              const i = document.createElement('input');
              i.name = 'roleIds';
              i.value = id;
              form.appendChild(i);
            });
            document.body.appendChild(form);
            form.submit();
          }
        }
      });
      app.mount('#adminProfileApp');
    })();
