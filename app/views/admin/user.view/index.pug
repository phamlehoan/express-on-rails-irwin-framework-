extends ../../layouts/admin/layout
include ../../layouts/admin/partials/tablePagination.mixin.pug

block content
  .container-fluid
    nav(aria-label="breadcrumb").breadcrumb-sticky
      ol.breadcrumb.mb-0
        li.breadcrumb-item.active(aria-current="page")= t('sidebar.account_management')

    .table-block.mb-4
      .table-toolbar.d-flex.align-items-center.flex-wrap.gap-2.p-3.bg-light.rounded-top.border.border-bottom-0
        form.d-flex.align-items-center.flex-grow-1(method="get" action="/admin/users" style="min-width: 0")
          input(type="hidden" name="sortBy" value=sortBy)
          input(type="hidden" name="sortOrder" value=sortOrder)
          input(type="hidden" name="filterStatus" value=filterStatus)
          input(type="hidden" name="perPage" value=perPage)
          .input-group.input-group-sm.me-auto(style="max-width: 500px")
            input.form-control.form-control-sm(type="search" name="search" placeholder=t('admin.search_by_account_email') value=search)
            button.btn.btn-sm.btn-primary(type="submit" title=t('search'))
              i.fa.fa-search
          .d-flex.align-items-center.gap-2.ms-auto
            select.form-select.form-select-sm(name="filterStatus" style="min-width: 110px" onchange="this.form.submit()")
              option(value="")= t('admin.all_status')
              option(value="ACTIVE" selected=filterStatus==='ACTIVE') ACTIVE
              option(value="INACTIVE" selected=filterStatus==='INACTIVE') INACTIVE
              option(value="PENDING" selected=filterStatus==='PENDING') PENDING
            button.btn.btn-sm.btn-outline-secondary(type="button" onclick="location.reload()" title=t('refresh'))
              i.fa.fa-refresh
        button.btn.btn-sm.btn-primary(type="button" data-bs-toggle="modal" data-bs-target="#newUserModal")
          i.fa.fa-plus.me-1
          = t('admin.new_user')
      .table-responsive.rounded-0
        table.table.table-hover.mb-0
          thead
            tr
              th
                a.text-decoration-none(href=buildSortUrl('email'))= t('admin.email')
                if sortBy === 'email'
                  i.fa.ms-1(class=sortOrder==='desc'?'fa-sort-desc':'fa-sort-asc' style="opacity:0.7")
              th
                a.text-decoration-none(href=buildSortUrl('firstName'))= t('admin.name')
                if sortBy === 'firstName'
                  i.fa.ms-1(class=sortOrder==='desc'?'fa-sort-desc':'fa-sort-asc' style="opacity:0.7")
              th
                a.text-decoration-none(href=buildSortUrl('status'))= t('admin.status')
                if sortBy === 'status'
                  i.fa.ms-1(class=sortOrder==='desc'?'fa-sort-desc':'fa-sort-asc' style="opacity:0.7")
              th= t('admin.roles')
              th.text-center.table-actions= t('actions')
          tbody
            each u in users
              tr.table-row-clickable(role="button" tabindex="0" data-href=`/admin/users/${u.id}`)
                td= u.email
                td= `${u.firstName} ${u.lastName}`
                td= u.status
                td= u.roles.map(r => r.role.name).join(", ") || "-"
                td.text-center.table-actions( onclick="event.stopPropagation()")
                  form.d-inline(method="post" action=`/admin/users/${u.id}?_method=DELETE` onsubmit=`return confirm("${t('admin.delete_user_confirm')}")`)
                    button.btn.btn-sm.btn-link.text-danger.p-0(type="submit" title="Delete")
                      i.fa.fa-trash
      +tablePagination("/admin/users", page, perPage, total, buildQueryString)
        input(type="hidden" name="search" value=search)
        input(type="hidden" name="sortBy" value=sortBy)
        input(type="hidden" name="sortOrder" value=sortOrder)
        input(type="hidden" name="filterStatus" value=filterStatus)

    //- New User Modal
    #newUserModal.modal.fade(tabindex="-1" aria-labelledby="newUserModalLabel" aria-hidden="true")
      .modal-dialog
        .modal-content
          form(method="post" action="/admin/users")
            .modal-header
              h5#newUserModalLabel.modal-title New User
              button.btn-close(type="button" data-bs-dismiss="modal" aria-label="Close")
            .modal-body
              .mb-3
                label.form-label= t('admin.first_name')
                input.form-control(name="firstName" required)
              .mb-3
                label.form-label= t('admin.last_name')
                input.form-control(name="lastName" required)
              .mb-3
                label.form-label= t('admin.email')
                input.form-control(name="email" type="email" required)
              .mb-3
                label.form-label= t('admin.roles')
                .dropdown(data-bs-auto-close="outside")
                  button#newUserRolesDropdown.btn.btn-outline-secondary.dropdown-toggle.w-100.text-start(type="button" data-bs-toggle="dropdown" aria-expanded="false")
                    span#newUserRolesLabel= t('admin.select_roles')
                  ul.dropdown-menu.p-2(style="max-height: 200px; overflow-y: auto")
                    each r in roles
                      li
                        label.dropdown-item.d-flex.align-items-center.cursor-pointer.mb-0
                          input.form-check-input.me-2(type="checkbox" name="roleIds" value=r.id)
                          span= r.name
            .modal-footer
              button.btn.btn-secondary(type="button" data-bs-dismiss="modal")= t('cancel')
              button.btn.btn-primary(type="submit")= t('create')

  script.
    (function() {
      const selectRoles = "!{t('admin.select_roles').replace(/"/g, '\\"')}";
      const rolesSelectedTpl = "!{t('admin.roles_selected').replace(/"/g, '\\"')}";
      const label = document.getElementById('newUserRolesLabel');
      const checkboxes = document.querySelectorAll('#newUserModal input[name="roleIds"]');
      function updateLabel() {
        if (!label) return;
        const checked = Array.from(checkboxes).filter(cb => cb.checked);
        label.textContent = checked.length ? rolesSelectedTpl.replace('{{count}}', checked.length) : selectRoles;
      }
      checkboxes.forEach(cb => cb.addEventListener('change', updateLabel));
      document.getElementById('newUserModal')?.addEventListener('show.bs.modal', updateLabel);
    })();
