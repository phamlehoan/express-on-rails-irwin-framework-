extends ../../layouts/admin/layout
include ../../layouts/admin/partials/tablePagination.mixin.pug

block content
  .container-fluid
    nav(aria-label="breadcrumb").breadcrumb-sticky
      ol.breadcrumb.mb-0
        li.breadcrumb-item
          a(href=withLocale('/admin/roles'))= t('sidebar.roles_permissions')
        li.breadcrumb-item.active(aria-current="page")= role.name

    //- Role Information
    .card.mb-4.content-card
      .card-header.d-flex.justify-content-between.align-items-center
        h6.mb-0.text-uppercase.text-primary.fw-bold Role Information
        .d-flex.gap-2
          button.btn.btn-sm.btn-warning(type="button" data-bs-toggle="modal" data-bs-target="#editRoleModal")
            i.fa.fa-edit.me-1
            | Edit
          if !role.isReadOnly
            form.d-inline(method="post" action=`/admin/roles/${role.id}?_method=DELETE` onsubmit="return confirm('Delete this role?')")
              button.btn.btn-sm.btn-danger(type="submit")
                i.fa.fa-trash.me-1
                | Delete
      .card-body
        .row
          .col-md-3
            label.text-muted.small Role Name
            p.mb-2.fw-semibold= role.name
          .col-md-3
            label.text-muted.small Role ID
            p.mb-2.fw-semibold= role.code
          .col-md-6
            label.text-muted.small Description
            p.mb-2= role.description || '-'

    //- Assigned Users
    .card.mb-4.content-card
      .card-header
        span.text-uppercase.text-primary.fw-bold Assigned Users
      .table-toolbar.d-flex.align-items-center.flex-wrap.gap-2.p-3.bg-light.border-bottom
        form.d-flex.align-items-center.flex-grow-1(method="get" action=`/admin/roles/${role.id}` style="min-width: 0")
          input(type="hidden" name="sortBy" value=sortBy)
          input(type="hidden" name="sortOrder" value=sortOrder)
          input(type="hidden" name="perPage" value=perPage)
          .input-group.input-group-sm.me-auto(style="max-width: 500px")
            input.form-control.form-control-sm(type="search" name="search" placeholder=t('admin.search_by_account_email') value=search)
            button.btn.btn-sm.btn-primary(type="submit" title=t('search'))
              i.fa.fa-search
          .d-flex.align-items-center.gap-2.ms-auto
            select.form-select.form-select-sm(name="filterStatus" style="min-width: 110px" onchange="this.form.submit()")
              option(value="")= t('admin.all_status')
              option(value="ACTIVE" selected=filterStatus==='ACTIVE') ACTIVE
              option(value="INACTIVE" selected=filterStatus==='INACTIVE') INACTIVE
              option(value="PENDING" selected=filterStatus==='PENDING') PENDING
            button.btn.btn-sm.btn-outline-secondary(type="button" onclick="location.reload()" title=t('refresh'))
              i.fa.fa-refresh
        button.btn.btn-sm.btn-primary(type="button" data-bs-toggle="modal" data-bs-target="#assignUserModal")
          i.fa.fa-plus.me-1
          | Assign User
      .card-body.p-0
        .px-3.pt-2
          .table-responsive.rounded
            table.table.table-hover.mb-0
              thead
                tr
                  th
                    a.text-decoration-none(href=buildSortUrl('accountName'))
                      | Account Name
                      if sortBy === 'accountName'
                        i.fa.ms-1(class=sortOrder==='desc'?'fa-sort-desc':'fa-sort-asc' style="opacity:0.7")
                  th
                    a.text-decoration-none(href=buildSortUrl('email'))
                      | Email
                      if sortBy === 'email'
                        i.fa.ms-1(class=sortOrder==='desc'?'fa-sort-desc':'fa-sort-asc' style="opacity:0.7")
                  th Account Type
                  th.text-center.table-actions(style="width: 80px") Action
              tbody
                each u in assignedUsers
                  tr
                    td= `${u.firstName || ''} ${u.lastName || ''}`.trim() || '-'
                    td= u.email
                    td= u.status || 'User'
                    td.text-center.table-actions
                      form.d-inline(method="post" action=`/admin/roles/${role.id}/users/${u.id}?_method=DELETE`)
                        button.btn.btn-sm.btn-link.text-danger.p-0(type="submit" onclick="return confirm('Unassign this user?')")
                          i.fa.fa-trash
                else
                  tr
                    td(colspan="4").text-muted.text-center.py-4 No users assigned
        +tablePagination(`/admin/roles/${role.id}`, page, perPage, totalAssigned, buildQueryString)
          input(type="hidden" name="search" value=search)
          input(type="hidden" name="sortBy" value=sortBy)
          input(type="hidden" name="sortOrder" value=sortOrder)
          input(type="hidden" name="filterStatus" value=filterStatus)

    //- Permission Information (Vue: RoleDetailPermissions — bundle.js)
    - const rolePermInitialIds = [...new Set((role.permissions || []).map(rp => rp.permissionId || (rp.permission && rp.permission.id)).filter(Boolean))]
    - const rolePermFormAction = withLocale('/admin/roles/' + role.id + '?_method=PUT')
    #rolePermissionsApp
    script#rolePermissionsData(type="application/json")
      != JSON.stringify({ formAction: rolePermFormAction, features, initialPermissionIds: rolePermInitialIds, isReadOnly: !!role.isReadOnly })

  //- Edit Role Modal
  #editRoleModal.modal.fade(tabindex="-1" aria-labelledby="editRoleModalLabel" aria-hidden="true")
    .modal-dialog
      .modal-content
        form(method="post" action=`/admin/roles/${role.id}?_method=PUT`)
          .modal-header
            h5#editRoleModalLabel.modal-title Edit Role
            button.btn-close(type="button" data-bs-dismiss="modal" aria-label="Close")
          .modal-body
            .mb-3
              label.form-label Code
              input.form-control(name="code" value=role.code required readonly=role.isReadOnly)
            .mb-3
              label.form-label Name
              input.form-control(name="name" value=role.name required)
            .mb-3
              label.form-label Description
              textarea.form-control(name="description" rows="2")= role.description || ''
          .modal-footer
            button.btn.btn-secondary(type="button" data-bs-dismiss="modal") Cancel
            button.btn.btn-primary(type="submit") Save

  //- Assign User Modal
  #assignUserModal.modal.fade(tabindex="-1" aria-labelledby="assignUserModalLabel" aria-hidden="true")
    .modal-dialog.modal-lg
      .modal-content
        form#assignUserForm(method="post" action=`/admin/roles/${role.id}/assign-user`)
          .modal-header
            h5#assignUserModalLabel.modal-title Assign User to #{role.name}
            button.btn-close(type="button" data-bs-dismiss="modal" aria-label="Close")
          .modal-body
            .mb-3
              label.form-label= t('admin.search_by_account_email')
              .input-group
                input.form-control#assignSearch(type="search" placeholder=t('admin.search_by_account_email'))
                button.btn.btn-primary(type="button" onclick="loadAssignUsers()" title=t('search'))
                  i.fa.fa-search
            #assignUsersContent
              p.text-muted.text-center.py-4 Loading...
          .modal-footer
            button.btn.btn-secondary(type="button" data-bs-dismiss="modal") Close
            button.btn.btn-primary(type="submit" id="assignSubmitBtn" disabled) Assign Selected

  script.
      const roleId = '#{role.id}';
      function loadAssignUsers() {
        const container = document.getElementById('assignUsersContent');
        if (!container) return;
        container.innerHTML = '<p class="text-muted text-center py-4">Loading...</p>';
        const search = document.getElementById('assignSearch')?.value || '';
        fetch(`/admin/roles/${roleId}/assign-users.json?search=${encodeURIComponent(search)}`, {
          headers: { 'Accept': 'application/json' }
        })
          .then(r => r.json())
          .then(data => {
            if (data.usersToAssign.length === 0) {
              container.innerHTML = '<p class="text-muted text-center py-4">No users available to assign.</p>';
              document.getElementById('assignSubmitBtn').disabled = true;
              return;
            }
            let html = '<table class="table table-hover"><thead><tr><th><input type="checkbox" id="assignSelectAll" onchange="toggleAssignAll(this)"></th><th>Account Name</th><th>Email</th></tr></thead><tbody>';
            data.usersToAssign.forEach(u => {
              const name = `${u.firstName || ''} ${u.lastName || ''}`.trim() || '-';
              html += `<tr><td><input type="checkbox" class="form-check-input" name="userIds" value="${u.id}"></td><td>${name}</td><td>${u.email}</td></tr>`;
            });
            html += '</tbody></table>';
            container.innerHTML = html;
            document.getElementById('assignSubmitBtn').disabled = false;
          })
          .catch(() => {
            document.getElementById('assignUsersContent').innerHTML = '<p class="text-danger">Failed to load users.</p>';
          });
      }
      function toggleAssignAll(cb) {
        document.querySelectorAll('#assignUsersContent input[name="userIds"]').forEach(i => i.checked = cb.checked);
      }
      document.getElementById('assignUserModal')?.addEventListener('shown.bs.modal', loadAssignUsers);
